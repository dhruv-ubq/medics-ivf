# ==========================================
# Deployment URL Subpath
# ==========================================
# If your application is served on a subpath (e.g. https://validation.medicsprime.in/medics-ivf):
# Set BASE_PATH=/medics-ivf
# If served at the domain root (e.g. http://localhost:3000 or https://medicsivf.in), leave it empty:
BASE_PATH=

# ==========================================
# MongoDB Connection Setup
# ==========================================
# Option A (MongoDB running on the host machine):
# MONGODB_URI=mongodb://host.docker.internal:27017/medics-ivf
#
# Option B (External / Remote / MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medics-ivf?retryWrites=true&w=majority
#
# Option C (Local development without Docker):
# MONGODB_URI=mongodb://localhost:27018/medics-ivf
#
# Option D (Bundled Docker Compose — mongo service in docker-compose.yml):
MONGODB_URI=mongodb://mongo:27017/medics-ivf
MONGODB_DB=medics-ivf

# Session lifetime in hours for the admin area
SESSION_TTL_HOURS=8

# ==========================================
# Initial Admin Credentials (used by seed)
# ==========================================
SEED_ADMIN_EMAIL=admin@ubq.in
SEED_ADMIN_NAME=medics IVF Admin
SEED_ADMIN_PASSWORD=choose-a-strong-password
